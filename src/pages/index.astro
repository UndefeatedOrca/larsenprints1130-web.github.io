---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { SITE } from '../site';
import { getProjects, isPinned } from '../projects';

const projects = await getProjects();
const pinned = projects.filter(isPinned);
// Show pinned projects; if none are pinned yet, fall back to the three newest.
const featured = pinned.length > 0 ? pinned : projects.slice(0, 3);
const heading = pinned.length > 0 ? 'Featured projects' : 'Recent projects';
---

<Base>
  <header class="page-head">
    <h1>{SITE.tagline}</h1>
    <p class="lede">
      A collection of projects, professional work, and the things I make along the way.
    </p>
  </header>

<p>
 Take a look around! Get a birds-eye view of me from the <a href={SITE.github} target="_blank" rel="noopener">About
 </a> page, learn about me <a href={SITE.github} target="_blank" rel="noopener">Professionally</a>
 , or just look at my <a href={SITE.github} target="_blank" rel="noopener">Projects</a>
  .
</p>

  <h2 style="margin-top:0">{heading}</h2>
  <ul class="project-list">
    {featured.map((p) => <ProjectRow id={p.id} {...p.data} />)}
  </ul>
  <a class="section-link" href="/projects">See all projects</a>
  <model-viewer class="hero-model" src="/3d-models/my-head-blend-3.glb" alt="3D model of my face" camera-controls auto-rotate environment-image="neutral" shadow-intensity="1"></model-viewer>
</Base>

<script>
  // Start downloading the 3D model only after the rest of the page has finished loading.
  const viewer = document.querySelector<HTMLElement>('.hero-model');
  const start = () => {
    const src = viewer?.dataset.src;
    if (viewer && src) viewer.setAttribute('src', src);
  };
  const later = () => {
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 });
    else setTimeout(start, 500);
  };
  if (document.readyState === 'complete') later();
  else window.addEventListener('load', later);
</script>