---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { SITE } from '../site';
import { getProjects, isPinned } from '../projects';

const projects = await getProjects();
const pinned = projects.filter(isPinned);
// Show pinned projects; if none are pinned yet, fall back to the three newest.
const featured = pinned.length > 0 ? pinned : projects.slice(0, 3);
const heading = pinned.length > 0 ? 'Featured projects' : 'Recent projects';
---

<Base>
  <header class="page-head">
    <h1>{SITE.tagline}</h1>
    <p class="lede">
      A collection of projects, professional work, and the things I make along the way.
    </p>
  </header>

  <h2 style="margin-top:0">{heading}</h2>
  <ul class="project-list">
    {featured.map((p) => <ProjectRow id={p.id} {...p.data} />)}
  </ul>
  <a class="section-link" href="/projects">See all projects</a>
</Base>