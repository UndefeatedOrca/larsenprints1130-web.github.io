---
// Used by the plain-text pages (About, Professional, Life Stuff).
// Those pages are Markdown files: just edit the words.
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <header class="page-head">
    <h1>{frontmatter.title}</h1>
    {frontmatter.intro && <p class="lede">{frontmatter.intro}</p>}
  </header>
  <div class="prose">
    <slot />
  </div>
</Base>
